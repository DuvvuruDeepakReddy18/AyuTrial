# ==============================================================================
# AIIA Clinical Trial Management System (AyuTrial) - Environment Variables
# Problem Statement: SIH26046 | All India Institute of Ayurveda & Ministry of Ayush
# ==============================================================================

# Mode: 'demo' (in-memory + local storage persistence) or 'production' (live cloud database)
NEXT_PUBLIC_APP_ENV=demo
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Supabase PostgreSQL Configuration
# If left empty, the application automatically runs in rich synthetic DEMO mode
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cryptographic Salt for Audit Trail Verification
AUDIT_TRAIL_SALT=aiia_npvcc_sih2026_alcoa_plus_secure_chain
